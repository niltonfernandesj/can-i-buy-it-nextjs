// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoTransacao {
  ENTRADA
  SAIDA
}

enum TipoConta {
  CONTA_CORRENTE
  CARTAO_CREDITO
  CONTA_INVESTIMENTO
}

// Enum legado, substituído pelo model Categoria (Design §18). Renomeado de
// `Categoria` na Task 90 só porque o Prisma não admite model e enum com o
// mesmo nome durante a fase de convivência — o rename é metadata-only e não
// altera valor algum. Sai de vez na Task 94, junto com as colunas que o usam.
enum CategoriaLegado {
  MERCADO
  LAZER
  SAUDE
  TRANSPORTE
  MORADIA
  SALARIO
  OUTROS
}

// Taxonomia compartilhada, sem usuarioId — ver justificativa no Design §18.1.
model Categoria {
  id       String   @id @default(cuid())
  nome     String   @unique
  cor      String // slug da paleta (Design §18.4), não hexadecimal
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  transacoes    Transacao[]
  valoresPadrao ValorPadrao[]
}

enum MeioPagamento {
  CREDITO
  DEBITO
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  ehAdmin      Boolean  @default(false) // gestão de usuários — spec-02 §17.2
  criadoEm     DateTime @default(now())

  contas        Conta[]
  transacoes    Transacao[]
  valoresPadrao ValorPadrao[]
}

model Conta {
  id             String   @id @default(cuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  nome           String
  tipo           TipoConta

  // Específicos de CARTAO_CREDITO (null para os demais tipos)
  diaFechamento  Int?
  diaVencimento  Int?

  criadoEm       DateTime @default(now())

  transacoes             Transacao[] @relation("ContaPrincipal")
  transacoesInvestimento Transacao[] @relation("ContaInvestimento")
}

model Transacao {
  id                String        @id @default(cuid())
  usuarioId         String
  usuario           Usuario       @relation(fields: [usuarioId], references: [id])

  tipo              TipoTransacao
  valor             Decimal       // sempre positivo; sinal é dado pelo `tipo`
  descricao         String

  // Convivência das duas categorias durante o M25 (Design §18.2): `categoria`
  // (enum) é a fonte da verdade até a Task 92; `categoriaId` nasce anulável na
  // Task 90 e vira obrigatório na 94, quando o enum sai e `categoriaNova`
  // assume o nome `categoria`.
  categoria         CategoriaLegado
  categoriaId       String?
  // onDelete: Restrict — a regra "não exclui categoria em uso" (Design §18.3)
  // é checada na Server Action, mas a FK é a garantia final; o default do
  // Prisma pra relação anulável seria SetNull, que anularia em silêncio.
  categoriaNova     Categoria?    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  contaId           String
  conta             Conta         @relation("ContaPrincipal", fields: [contaId], references: [id])

  dataCompra        DateTime
  dataEfetiva       DateTime
  mesReferencia     Int           // 1-12
  anoReferencia     Int

  // Parcelamento (null quando não é compra parcelada)
  numeroParcela     Int?
  totalParcelas     Int?
  parcelamentoId    String?

  // Investimento
  ehInvestimento      Boolean @default(false)
  contaInvestimentoId String?
  contaInvestimento   Conta?  @relation("ContaInvestimento", fields: [contaInvestimentoId], references: [id])

  criadoEm          DateTime      @default(now())

  consolidacaoDespesa ConsolidacaoDespesaPadrao?

  @@index([usuarioId])
  @@index([contaId])
  @@index([mesReferencia, anoReferencia])
  @@index([parcelamentoId])
  @@index([categoriaId])
}

model ValorPadrao {
  id        String        @id @default(cuid())
  usuarioId String
  usuario   Usuario       @relation(fields: [usuarioId], references: [id])

  descricao String
  valor     Decimal // sempre positivo; sinal é dado pelo `tipo`
  tipo      TipoTransacao // ENTRADA (receita padrão) | SAIDA (despesa padrão)
  meio      MeioPagamento? // obrigatório quando tipo = SAIDA; null quando ENTRADA
  categoria     CategoriaLegado? // obrigatória quando tipo = SAIDA; null quando ENTRADA — pré-preenche a consolidação de despesa (Task 79)
  categoriaId   String? // convivência do M25 (Design §18.2); segue anulável depois da Task 94, espelhando a regra acima
  categoriaNova Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  consolidacoesReceita ConsolidacaoReceitaPadrao[]
  consolidacoesDespesa ConsolidacaoDespesaPadrao[]

  @@index([usuarioId])
  @@index([categoriaId])
}

// Ajuste pontual de um item de receita padrão pra um mês específico
// (spec-01 §3.8, spec-02 §13.5) — substitui ValorPadrao.valor só naquele
// mês, sem tocar no item nem nos demais meses. Renomeado de
// ConsolidacaoValorPadrao na Task 76, quando ConsolidacaoDespesaPadrao
// (Task 78) tornou o nome genérico ambíguo.
model ConsolidacaoReceitaPadrao {
  id            String      @id @default(cuid())
  valorPadraoId String
  valorPadrao   ValorPadrao @relation(fields: [valorPadraoId], references: [id])

  mesReferencia Int // 1-12
  anoReferencia Int
  valor         Decimal // substitui ValorPadrao.valor só nesse mês

  criadoEm DateTime @default(now())

  @@unique([valorPadraoId, mesReferencia, anoReferencia])
  @@index([mesReferencia, anoReferencia])
}

// Marca que um item de despesa padrão no débito foi resolvido num mês
// (spec-01 §3.9, spec-02 §13.6). Diferente da consolidação de receita, esta
// gera um lançamento real — daí o vínculo com Transacao.
model ConsolidacaoDespesaPadrao {
  id            String      @id @default(cuid())
  valorPadraoId String
  valorPadrao   ValorPadrao @relation(fields: [valorPadraoId], references: [id])

  mesReferencia Int // 1-12
  anoReferencia Int

  // null = consolidado por R$ 0 ("não precisei pagar neste mês"), sem
  // lançamento. Quando presente, o valor vem da própria transação — sem
  // coluna `valor` aqui, pra não existir duas fontes de verdade.
  transacaoId String?    @unique
  transacao   Transacao? @relation(fields: [transacaoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@unique([valorPadraoId, mesReferencia, anoReferencia])
  @@index([mesReferencia, anoReferencia])
}
